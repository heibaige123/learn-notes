{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["projects/**", "notes/**", "node_modules/**"],
  "env": {
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "max-lines": ["error", { "max": 200 }],
    "no-unused-vars": "error"
  }
}
